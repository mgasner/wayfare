{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:file/:export",
      "destination": "/api/route?file=:file&export=:export"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/slots",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/cron/slots.ts": {
      "maxDuration": 300
    }
  }
}
