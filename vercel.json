{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:file/:export",
      "destination": "/api/route?file=:file&export=:export"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
