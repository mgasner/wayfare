# Local: a plain SQLite file and a fixed user. `pnpm db:setup` creates it.
DB_FILE=./local.db
DEV_USER=max@indent.com

# Deployed: the file in R2. DB_KEY defaults to prod.db when VERCEL_ENV=production, else dev.db.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# DB_KEY=dev.db

# Google sign-in. DEV_USER is ignored on Vercel (VERCEL is set there).
# APP_URL defaults to the request's origin; the redirect URI is $APP_URL/api/auth/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=http://localhost:5173
# SESSION_SECRET=   # 32+ characters: openssl rand -base64 32

# Bearer token for the agent API (server/agent.ts); the same value is an Indent secret.
# AGENT_TOKEN=
