# Which deployment this is: production, preview or local. Required everywhere; set it per environment in the
# Vercel project (Production: production, Preview: preview). Missing or unknown, nothing opens the database.
WAYFARE_ENV=local

# Local: a plain SQLite file and a fixed user. `pnpm db:setup` creates it. DB_FILE and DEV_USER only work with WAYFARE_ENV=local.
DB_FILE=./local.db
DEV_USER=max@indent.com

# Deployed: the file in R2. DB_KEY defaults to prod.db when WAYFARE_ENV=production, else dev.db.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# DB_KEY=dev.db

# Google sign-in.
# APP_URL defaults to the request's origin; the redirect URI is $APP_URL/api/auth/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=http://localhost:5173
# SESSION_SECRET=   # 32+ characters: openssl rand -base64 32

# Bearer token for the agent API (server/agent.ts); the same value is an Indent secret.
# AGENT_TOKEN=

# Vercel sends it as a bearer token to api/cron/*.
# CRON_SECRET=
# Comma-separated channels whose live reads fail as blocked (mesa247, meitre), to exercise fallbacks.
# BLOCK_CHANNELS=

# Transcription (OpenAI directly). REAL_API=1 pnpm vitest run test/real.test.ts runs the real-call tests.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRANSCRIBE_MODEL=gpt-transcribe

# Interpretation: Claude over an OpenAI-compatible endpoint, Vercel AI Gateway by default.
# AI_GATEWAY_API_KEY=
# MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# MODEL_API_KEY=          # defaults to AI_GATEWAY_API_KEY
# INTERPRET_MODEL=anthropic/claude-sonnet-5.5

# Travel times: Google Routes API (computeRouteMatrix). Without it, a distance estimate marked estimated.
# GOOGLE_MAPS_KEY=
